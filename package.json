{
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.29.0"
  },
  "scripts": {
    "audit:duplicates": "node scripts/check-existing-duplicates.mjs",
    "storage:permissions:check": "node scripts/storage-cross-service.mjs --check",
    "storage:permissions:fix": "node scripts/storage-cross-service.mjs --apply",
    "storage:verify": "node scripts/verify-storage-upload.mjs --run",
    "test:storage:permissions": "node --test security-tests/storage-cross-service.test.mjs",
    "superuser:password": "node scripts/configure-superuser-password.mjs --create",
    "superuser:password:check": "node scripts/configure-superuser-password.mjs --check",
    "superuser:password:rotate": "node scripts/configure-superuser-password.mjs --rotate",
    "superuser:assign": "node scripts/set-platform-admin.mjs --assign",
    "superuser:inspect": "node scripts/set-platform-admin.mjs --check",
    "superuser:configure": "node scripts/superuser-admin.mjs --configure",
    "superuser:rotate": "node scripts/superuser-admin.mjs --rotate",
    "superuser:complete": "node scripts/superuser-admin.mjs --complete",
    "superuser:check": "node scripts/superuser-admin.mjs --check",
    "superuser:create": "node scripts/superuser-admin.mjs --create",
    "test:superuser": "node --test security-tests/superuser.test.mjs security-tests/superuser-cli.test.mjs security-tests/platform-admin.test.mjs",
    "deploy:check": "set DEBUG=& firebase deploy --dry-run --non-interactive",
    "build:android": "node scripts/build-android.mjs",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:apk": "npm run android:sync && node scripts/gradle-android.mjs assembleDebug",
    "android:bundle": "npm run android:sync && node scripts/gradle-android.mjs bundleRelease",
    "test:android": "npm run build:android && node --test mobile-tests/*.test.mjs",
    "test:security:client": "node --test security-tests/client.test.mjs security-tests/tomb-cemetery-session.test.mjs security-tests/dispute-notifications.test.mjs security-tests/terms.test.mjs security-tests/death-age.test.mjs security-tests/monetization.test.mjs security-tests/google-auth.test.mjs",
    "test:security:rules": "firebase emulators:exec --project demo-buscatumbas-security --only firestore,storage \"node --test security-tests/rules.test.mjs security-tests/record-writes.integration.test.mjs\"",
    "test:search": "node --test security-tests/search.test.mjs",
    "google:check": "node scripts/google-auth-config.mjs --check",
    "google:sync": "node scripts/google-auth-config.mjs --sync",
    "test:google": "node --test security-tests/google-auth.test.mjs"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.13.6"
    },
    "@opentelemetry/core": "^2.8.0",
    "gaxios@6.7.1": {
      "uuid": "11.1.1"
    },
    "xcode@3.0.1": {
      "uuid": "11.1.1"
    }
  }
}

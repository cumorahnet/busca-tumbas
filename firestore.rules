rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('platform_admin', false) == true
        && request.auth.token.get('superuser_session', false) == true
        && request.auth.token.get('superuser_until', 0) > request.time.toMillis() / 1000;
    }

    function ownsExistingRecord() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function canContribute() {
      return signedIn() && (!exists(/databases/$(database)/documents/_moderation/$(request.auth.uid))
        || get(/databases/$(database)/documents/_moderation/$(request.auth.uid)).data.suspendedUntil <= request.time);
    }

    function ownsIncomingRecord() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function validTomb() {
      return request.resource.data.keys().hasAll([
          'userId',
          'timestamp',
          'imageUrl'
        ])
        && request.resource.data.keys().hasOnly([
          'userId',
          'contributorId',
          'contributor_name',
          'contributor_email',
          'timestamp',
          'imageUrl',
          'geolocation',
          'panteon_geolocation',
          'nombre_finado',
          'nombre_finado_lower',
          'nombres',
          'nombres_lower',
          'apellido_paterno',
          'apellido_paterno_lower',
          'apellido_materno',
          'apellido_materno_lower',
          'fecha_nacimiento',
          'fecha_nacimiento_iso',
          'fecha_nacimiento_estimada',
          'fecha_defuncion',
          'fecha_defuncion_iso',
          'edad_defuncion',
          'nombre_panteon',
          'nombre_panteon_lower',
          'pais_panteon',
          'estado_panteon',
          'estado_panteon_lower',
          'municipio_panteon',
          'municipio_panteon_lower',
          'colonia_panteon',
          'inegi_denue_id',
          'cemetery_id',
          'cemetery_source',
          'record_key',
          'person_key',
          'image_hash',
          'image_fingerprint',
          'last_updated',
          'last_updated_by',
          'visibility',
          'status'
        ])
        && request.resource.data.userId is string
        && request.resource.data.get('contributorId', request.auth.uid) == request.auth.uid
        && request.resource.data.timestamp is timestamp
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 2048
        && (!request.resource.data.keys().hasAny(['nombres'])
          || request.resource.data.nombres == null
          || request.resource.data.nombres is string)
        && (!request.resource.data.keys().hasAny(['nombres_lower'])
          || request.resource.data.nombres_lower == null
          || request.resource.data.nombres_lower is string)
        && (!request.resource.data.keys().hasAny(['apellido_paterno'])
          || request.resource.data.apellido_paterno == null
          || request.resource.data.apellido_paterno is string)
        && (!request.resource.data.keys().hasAny(['apellido_paterno_lower'])
          || request.resource.data.apellido_paterno_lower == null
          || request.resource.data.apellido_paterno_lower is string)
        && (!request.resource.data.keys().hasAny(['apellido_materno'])
          || request.resource.data.apellido_materno == null
          || request.resource.data.apellido_materno is string)
        && (!request.resource.data.keys().hasAny(['apellido_materno_lower'])
          || request.resource.data.apellido_materno_lower == null
          || request.resource.data.apellido_materno_lower is string)
        && (!request.resource.data.keys().hasAny(['fecha_nacimiento_estimada'])
          || request.resource.data.fecha_nacimiento_estimada is bool)
        && (!request.resource.data.keys().hasAny(['edad_defuncion'])
          || request.resource.data.edad_defuncion == null
          || (request.resource.data.edad_defuncion is int
            && request.resource.data.edad_defuncion >= 0
            && request.resource.data.edad_defuncion <= 130))
        && (!request.resource.data.keys().hasAny(['estado_panteon_lower'])
          || request.resource.data.estado_panteon_lower == null
          || request.resource.data.estado_panteon_lower is string)
        && (!request.resource.data.keys().hasAny(['municipio_panteon_lower'])
          || request.resource.data.municipio_panteon_lower == null
          || request.resource.data.municipio_panteon_lower is string)
        && (!request.resource.data.keys().hasAny(['pais_panteon'])
          || (request.resource.data.pais_panteon is string
            && request.resource.data.pais_panteon.size() > 0
            && request.resource.data.pais_panteon.size() <= 100))
        && request.resource.data.visibility == 'public'
        && request.resource.data.status in ['published', 'pending'];
    }

    match /tumbas/{tombId} {
      match /photos/{photoId} {
        allow read: if signedIn();
        allow write: if false;
      }
      // El catálogo es compartido entre todos los usuarios registrados.
      allow read: if signedIn();
      // Identity writes are validated and serialized in callable functions.
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    function validMessage(message) {
      return message is map
        && message.keys().hasOnly(['senderId', 'senderName', 'text', 'createdAt'])
        && message.senderId == request.auth.uid
        && message.senderName is string
        && message.senderName.size() <= 200
        && message.text is string
        && message.text.size() > 0 && message.text.size() <= 1500
        && message.createdAt is int;
    }

    function validCorrectionTarget() {
      let data = request.resource.data;
      return data.tombId is string && data.tombId.matches('^[A-Za-z0-9_-]{1,128}$')
        && (data.get('recordType', 'tomb') == 'tomb'
          ? get(/databases/$(database)/documents/tumbas/$(data.tombId)).data.userId == data.tombOwnerId
          : isAdmin() && get(/databases/$(database)/documents/cemeteries/$(data.tombId)).data.contributorId == data.tombOwnerId);
    }

    function validMessageUpdate() {
      let old = resource.data.messages;
      let next = request.resource.data.messages;
      return next == old || (resource.data.status == 'open'
        && next.size() == old.size() + 1
        && validMessage(next[next.size() - 1])
        && next.removeAll([next[next.size() - 1]]) == old);
    }

    match /correction_requests/{requestId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participants;
      // User error notes must go through enviarNotaError for atomic counting.
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'tombId', 'tombName', 'tombOwnerId', 'requesterId',
          'requesterName', 'description', 'status', 'participants',
          'readBy', 'messages', 'recordType', 'createdAt', 'updatedAt'
        ])
        && validCorrectionTarget()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.tombOwnerId != request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.tombOwnerId in request.resource.data.participants
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 1500
        && request.resource.data.messages is list
        && request.resource.data.messages.size() == 1
        && validMessage(request.resource.data.messages[0])
        && request.resource.data.readBy == [request.auth.uid]
        && (!request.resource.data.keys().hasAny(['recordType'])
          || request.resource.data.recordType in ['tomb', 'cemetery'])
        && request.resource.data.status == 'open';
      allow update: if signedIn() && request.auth.token.get('profile_complete', false) == true
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.tombId == resource.data.tombId
        && request.resource.data.tombOwnerId == resource.data.tombOwnerId
        && request.resource.data.requesterId == resource.data.requesterId
        && request.resource.data.status in ['open', 'resolved']
        && (request.resource.data.status == resource.data.status
          || request.auth.uid == resource.data.tombOwnerId)
        && request.resource.data.messages is list
        && request.resource.data.messages.size() <= 200
        && validMessageUpdate()
        && request.resource.data.readBy is list
        && request.resource.data.readBy.size() <= 2
        && request.resource.data.readBy.hasOnly(resource.data.participants)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['messages', 'readBy', 'status', 'updatedAt']);
      allow delete: if false;
    }

    function validPlaceType(data) {
      return data.get('placeType', 'cemetery') in ['cemetery', 'church', 'hospital', 'convent', 'other']
        && data.get('otherPlaceType', '') is string
        && data.get('otherPlaceType', '').size() <= 100
        && (data.get('placeType', 'cemetery') != 'other' || data.get('otherPlaceType', '').matches('.*\\S.*'))
        && (!data.keys().hasAny(['inegiCemeteryId']) || data.get('placeType', 'cemetery') == 'cemetery');
    }

    match /cemeteries/{cemeteryId} {
      allow read: if signedIn();
      allow create: if false;
      // Moderation status changes do not alter identity.
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'adminNote', 'reviewedAt', 'reviewedBy', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // Solo Cloud Functions usa esta colección con Admin SDK.
    match /_moderation/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /_rateLimits/{document=**} {
      allow read, write: if false;
    }
    match /_duplicateDisputes/{caseId} {
      allow read: if isAdmin() || (signedIn() && resource.data.contributorId == request.auth.uid);
      allow write: if false;
    }

    // Beneficios Plus y recompensas se calculan exclusivamente en el servidor.
    match /_entitlements/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

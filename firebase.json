{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebase/**",
      ".firebaserc",
      ".git/**",
      ".gitdata/**",
      ".github/**",
      ".cdc/**",
      ".vscode/**",
      ".gitignore",
      "firebase-debug.log",
      "package.json",
      "package-lock.json",
      "README.md",
      "CHANGELOG.md",
      "DECISIONS.md",
      "NEXT.md",
      "firestore.rules",
      "firestore.indexes.json",
      "storage.rules",
      "functions/**",
      "scripts/**",
      "**/.*",
      "**/node_modules/**",
      "index.html.backup",
      "android/**",
      "www/**",
      "capacitor.config.json",
      "ANDROID.md",
      "mobile-tests/**",
      ".android-cache/**",
      ".browser-check/**",
      ".record-audit/**",
      "security-tests/**",
      "SECURITY-REVIEW.md",
      "**/*-debug.log",
      "**/*.test.*",
      "MONETIZATION.md",
      "branding/**",
      "ios/**",
      "IOS.md",
      "storage.cors.json"
    ],
    "rewrites": [{"source": "/api/tomb-photo", "function": {"functionId": "descargarFotografiaTumba", "region": "us-central1"}}],
    "headers": [
      {
        "source": "/mobile/install.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/version.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), geolocation=(self)"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          }
        ]
      }
    ]
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true
    }
  }
}
